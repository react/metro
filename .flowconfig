[ignore]
packages/*/build/**
.hg/**
.sl/**
.git/**
.claude/**
# this transient dep bundles tests with their package, which flow attempts to parse
# and crashes out as the test includes purposely malformed json
**/node_modules/resolve/test/**
**/node_modules/invariant/**
# Workspace packages are mapped to their sources below. pnpm also links them
# into each other's node_modules, forming cycles (metro -> metro-config ->
# metro) that Flow would otherwise crawl forever.
**/node_modules/metro*/**
**/node_modules/ob1/**
**/node_modules/buck-worker-tool/**

[options]
emoji=true
format.bracket_spacing=false

munge_underscores=true

module.name_mapper='^metro-memory-fs$' -> '<PROJECT_ROOT>/private/metro-memory-fs'
module.name_mapper='^\(metro\|metro-[a-z-]+\|ob1\|buck-worker-tool\)/\(private\|src\)/\(.*\)$' -> '<PROJECT_ROOT>/packages/\1/src/\3'
module.name_mapper='^\(metro\|metro-[a-z-]+\|ob1\|buck-worker-tool\)$' -> '<PROJECT_ROOT>/packages/\1'

[lints]
sketchy-null-number=warn
sketchy-null-mixed=warn
sketchy-number=warn
untyped-type-import=warn
nonstrict-import=warn
deprecated-type=error
unsafe-getters-setters=warn
unnecessary-invariant=warn
unused-promise=error

[strict]
deprecated-type
nonstrict-import
sketchy-null
unclear-type
unsafe-getters-setters
untyped-import
untyped-type-import

[version]
^0.340.0
