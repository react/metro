.eslintcache
/node_modules
/packages/*/node_modules/
/private/*/node_modules/
# yarn.lock is the source of truth, pnpm-lock.yaml is generated by `pnpm import`
pnpm-lock.yaml
/coverage
/reports
npm-debug.log*
packages/*/build/
# Generated TypeScript definitions. Build artifacts produced on demand from
# Flow sources (for npm publish and public API snapshotting); not checked in.
packages/*/types/

website/build/
website/i18n/*
website/node_modules
website/translated_docs
.idea
.vscode
.docusaurus
.cache-loader
yarn-error.log
